{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AzureDataFactoryJrk"
		},
		"ADLS_JRK_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_JRK'"
		},
		"LS_SQLSERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER'"
		},
		"LS_SQL_VISIONBOARD_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_VISIONBOARD_DB'"
		},
		"ADLS_JRK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsjrk.dfs.core.windows.net/"
		},
		"LS_SQLSERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "KITTU\\SQLEXPRESS"
		},
		"LS_SQLSERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2019"
		},
		"LS_SQLSERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"LS_SQL_VISIONBOARD_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "KITTU\\SQLEXPRESS"
		},
		"LS_SQL_VISIONBOARD_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "VISIONBOARD"
		},
		"LS_SQL_VISIONBOARD_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AzureDataFactoryJrk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLS_JRK_accountKey": {
						"value": "[parameters('ADLS_JRK_accountKey')]"
					},
					"LS_SQLSERVER_password": {
						"value": "[parameters('LS_SQLSERVER_password')]"
					},
					"LS_SQL_VISIONBOARD_DB_password": {
						"value": "[parameters('LS_SQL_VISIONBOARD_DB_password')]"
					},
					"ADLS_JRK_properties_typeProperties_url": {
						"value": "[parameters('ADLS_JRK_properties_typeProperties_url')]"
					},
					"LS_SQLSERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_properties_typeProperties_userName')]"
					},
					"LS_SQL_VISIONBOARD_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_VISIONBOARD_DB_properties_typeProperties_server')]"
					},
					"LS_SQL_VISIONBOARD_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_VISIONBOARD_DB_properties_typeProperties_database')]"
					},
					"LS_SQL_VISIONBOARD_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_VISIONBOARD_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}